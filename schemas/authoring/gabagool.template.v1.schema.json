{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gabagool.template.v1",
  "title": "Level template",
  "description": "packages/service/templates/<id>.json: what a new design starts from -- the batch it imports as and the mission brief its defaults make.",
  "type": "object",
  "required": ["schema", "template_id", "label", "description", "batch", "brief"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "gabagool.template.v1"},
    "template_id": {"type": "string", "pattern": "^[a-z0-9_]+$", "description": "Matches the file name."},
    "label": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "batch": {
      "type": "object",
      "required": ["seed_base", "theme_family"],
      "additionalProperties": false,
      "properties": {
        "seed_base": {"type": "integer", "minimum": 0},
        "theme_family": {"type": "string", "minLength": 1}
      }
    },
    "brief": {
      "type": "object",
      "required": ["schema", "archetype", "candidate_count"],
      "$comment": "The brief's own fields are level_factory.mission_brief.v0.1 (schemas/mission.brief.schema.json); only what a template must carry is required here.",
      "properties": {
        "schema": {"const": "level_factory.mission_brief.v0.1"},
        "archetype": {"type": "string", "minLength": 1},
        "candidate_count": {"type": "integer", "minimum": 1, "maximum": 8}
      }
    }
  }
}
